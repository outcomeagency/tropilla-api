APP_NAME=TROPILLA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8090

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL 16 + PostGIS (servicio `postgres` de compose.yaml).
# Desde el host: localhost:5442. Pest usa ${DB_DATABASE}_test (ver phpunit.xml).
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=tropilla
DB_USERNAME=tropilla
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# Redis 7 (servicio `redis`). Desde el host: localhost:6389.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@tropilla.local"
MAIL_FROM_NAME="${APP_NAME}"

# Archivos: MinIO (S3-compatible) en dev; S3/R2 en producción.
# Consola MinIO: http://localhost:9011 (tropilla / secretsecret).
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=tropilla
AWS_SECRET_ACCESS_KEY=secretsecret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=tropilla
AWS_ENDPOINT=http://minio:9000
AWS_URL=http://localhost:9010/tropilla
# Host con el que el teléfono/navegador llega a MinIO para las subidas prefirmadas (TPA-44). Emulador Android: http://10.0.2.2:9010
AWS_PUBLIC_ENDPOINT=http://localhost:9010
AWS_USE_PATH_STYLE_ENDPOINT=true

# Gotenberg (HTML → PDF). Desde el host: localhost:3010.
GOTENBERG_URL=http://gotenberg:3000

# Orígenes con cookie de sesión Sanctum (tropilla-next en dev).
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# Entrypoint: correr seeders al arrancar (false en entornos compartidos).
SEED_ON_BOOT=true

# Captcha del contacto público (Cloudflare Turnstile). Obligatorio en producción.
TURNSTILE_SECRET=

# Anclaje diario de integridad (TPA-40): stub (local/testing, confirma al instante) | opentimestamps (staging/producción).
# Con stub en producción la app no arranca.
TROPILLA_ANCLAJE_DRIVER=stub

# Push (TPA-53): log (local) | fcm. Con fcm, ruta al JSON de la cuenta de servicio de Firebase.
TROPILLA_PUSH_DRIVER=log
TROPILLA_FCM_CREDENCIALES=

# Lectura asistida de planillas (TPA-61/62): gemini | claude | deshabilitado | fake (solo tests).
# Sin TROPILLA_EXTRACCION_DRIVER: gemini si hay GEMINI_API_KEY, si no claude si hay ANTHROPIC_API_KEY, si no deshabilitado.
# Las keys NUNCA se commitean.
# TROPILLA_EXTRACCION_DRIVER=gemini
GEMINI_API_KEY=
TROPILLA_EXTRACCION_GEMINI_MODELO=gemini-flash-latest
# thinkingLevel de Gemini (low = ~8 s por acta); vacío para modelos que no lo soportan.
TROPILLA_EXTRACCION_GEMINI_RAZONAMIENTO=low
ANTHROPIC_API_KEY=
TROPILLA_EXTRACCION_MODELO=claude-haiku-4-5-20251001
TROPILLA_EXTRACCION_TIMEOUT=120
