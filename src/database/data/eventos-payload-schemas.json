{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tropilla.app/schemas/eventos-payload/1",
  "title": "TROPILLA — payload por tipo de evento (tipo_version 1)",
  "$comment": "Seed de tipos_evento_versiones.json_schema (version 1). Tablas legibles en technical/modelo-datos.md §5: mantener ambos en sincronía (este JSON manda).",
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "decimal": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$",
      "description": "Decimal canónico como string (sin ceros de más, sin exponente)"
    },
    "decimal_pos": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"
    },
    "fecha": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "fechahora": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "codigo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.\\-]{1,64}$",
      "description": "Código de catálogo"
    },
    "texto": {
      "type": "string",
      "maxLength": 2000
    },
    "texto_corto": {
      "type": "string",
      "maxLength": 200
    },
    "identificacion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tipo",
        "valor"
      ],
      "properties": {
        "tipo": {
          "enum": [
            "caravana_visual",
            "caravana_oficial",
            "rfid",
            "tatuaje",
            "marca_senal",
            "registro_genealogico"
          ]
        },
        "valor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "entidad": {
          "$ref": "#/$defs/texto_corto",
          "description": "Registro genealógico: AACB, SRA…"
        },
        "tipo_registro": {
          "enum": [
            "P1",
            "P2",
            "D",
            "C",
            "B1",
            "B2",
            "otro"
          ]
        },
        "colocada_en": {
          "$ref": "#/$defs/fecha"
        }
      }
    },
    "cruza": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "raza"
        ],
        "properties": {
          "raza": {
            "$ref": "#/$defs/codigo"
          },
          "pct": {
            "$ref": "#/$defs/decimal_pos"
          }
        }
      }
    },
    "animal_nuevo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "animal_id",
        "especie",
        "sexo",
        "categoria"
      ],
      "properties": {
        "animal_id": {
          "$ref": "#/$defs/uuid"
        },
        "especie": {
          "enum": [
            "BOV",
            "BUB"
          ]
        },
        "sexo": {
          "enum": [
            "M",
            "H"
          ]
        },
        "categoria": {
          "$ref": "#/$defs/codigo"
        },
        "raza": {
          "$ref": "#/$defs/codigo"
        },
        "cruza": {
          "$ref": "#/$defs/cruza"
        },
        "fecha_nacimiento": {
          "$ref": "#/$defs/fecha"
        },
        "nacimiento_estimado": {
          "type": "boolean"
        },
        "castrado": {
          "type": "boolean"
        },
        "denticion": {
          "enum": [
            "leche",
            "2",
            "4",
            "6_mas"
          ]
        },
        "madre_id": {
          "$ref": "#/$defs/uuid"
        },
        "padre_id": {
          "$ref": "#/$defs/uuid"
        },
        "madre_externa_id": {"$ref":"#/$defs/uuid"},
        "padre_externo_id": {"$ref":"#/$defs/uuid"},
        "madre_externa": {
          "$ref": "#/$defs/texto_corto"
        },
        "padre_externo": {
          "$ref": "#/$defs/texto_corto"
        },
        "identificaciones": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/identificacion"
          }
        },
        "senas": {
          "$ref": "#/$defs/texto"
        },
        "foto": {
          "$ref": "#/$defs/sha256"
        },
        "lote_id": {
          "$ref": "#/$defs/uuid"
        },
        "potrero_id": {
          "$ref": "#/$defs/uuid"
        }
      }
    },
    "cria": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "viva"
      ],
      "properties": {
        "viva": {
          "type": "boolean"
        },
        "animal": {
          "$ref": "#/$defs/animal_nuevo",
          "description": "Obligatorio si viva=true"
        },
        "sexo": {
          "enum": [
            "M",
            "H"
          ],
          "description": "Si viva=false y no se da de alta"
        },
        "peso_kg": {
          "$ref": "#/$defs/decimal_pos"
        }
      }
    }
  },
  "tipos": {
    "hacienda.alta": {
      "nombre": "Alta de existencia (inventario inicial / alta rápida / importación)",
      "fase": "MVP",
      "sujetos": "animales | lote(conteo)",
      "crea_animales": true,
      "payload": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "motivo": {
            "enum": [
              "inventario_inicial",
              "alta_rapida",
              "importacion"
            ]
          },
          "animales": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "$ref": "#/$defs/animal_nuevo"
            }
          },
          "importacion_id": {
            "$ref": "#/$defs/uuid"
          }
        },
        "required": [
          "motivo"
        ]
      }
    },
    "hacienda.nacimiento": {
      "nombre": "Nacimiento (madre fuera del sistema o en lote anónimo)",
      "fase": "MVP",
      "sujetos": "animales(nuevos) | lote(conteo)",
      "crea_animales": true,
      "payload": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "crias": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "$ref": "#/$defs/cria"
            }
          },
          "madre_id": {
            "$ref": "#/$defs/uuid"
          },
          "madre_externa": {
            "$ref": "#/$defs/texto_corto"
          },
          "facilidad": {
            "enum": [
              "normal",
              "asistido",
              "distocico",
              "cesarea"
            ]
          }
        }
      }
    },
    "hacienda.ingreso": {
      "nombre": "Ingreso / compra",
      "fase": "MVP",
      "sujetos": "animales(nuevos) | lote(conteo)",
      "crea_animales": true,
      "payload": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "motivo": {
            "enum": [
              "compra",
              "traslado_externo",
              "capitalizacion",
              "devolucion",
              "otro"
            ]
          },
          "origen": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "vendedor": {
                "$ref": "#/$defs/texto_corto"
              },
              "establecimiento": {
                "$ref": "#/$defs/texto_corto"
              },
              "renspa_declarado": {
                "$ref": "#/$defs/texto_corto"
              },
              "localidad": {
                "$ref": "#/$defs/texto_corto"
              }
            }
          },
          "animales": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "$ref": "#/$defs/animal_nuevo"
            }
          },
          "dte_numero": {
            "$ref": "#/$defs/texto_corto"
          },
          "documento_ids": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "$ref": "#/$defs/uuid"
            }
          },
          "operacion_id": {
            "$ref": "#/$defs/uuid"
          }
        },
        "required": [
          "motivo"
        ]
      }
    },
    "hacienda.egreso": {
      "nombre": "Egreso / venta",
      "fase": "MVP",
      "sujetos": "animales | lote(conteo)",
      "crea_animales": false,
      "payload": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "motivo": {
            "enum": [
              "venta",
              "traslado_externo",
              "entrega_contrato",
              "otro"
            ]
          },
          "comprador": {
            "$ref": "#/$defs/texto_corto"
          },
          "destino": {
            "enum": [
              "faena",
              "invernada",
              "cria",
              "exportacion",
              "otro"
            ]
          },
          "destino_establecimiento": {
            "$ref": "#/$defs/texto_corto"
          },
          "renspa_destino_declarado": {
            "$ref": "#/$defs/texto_corto"
          },
          "dte_numero": {
            "$ref": "#/$defs/texto_corto"
          },
          "documento_ids": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "$ref": "#/$defs/uuid"
            }
          },
          "operacion_id": {
            "$ref": "#/$defs/uuid"
          },
          "contrato_id": {
            "$ref": "#/$defs/uuid"
          }
        },
        "required": [
          "motivo"
        ]
      }
    },
    "hacienda.traslado": {
      "nombre": "Traslado interno (potrero)",
      "fase": "MVP",
      "sujetos": "animales | lote",
      "crea_animales": false,
      "payload": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "potrero_destino_id": {
            "$ref": "#/$defs/uuid"
          },
          "potrero_origen_id": {
            "$ref": "#/$defs/uuid"
          }
        },
        "required": [
          "potrero_destino_id"
        ]
      }
    },
    "hacienda.cambio_lote": {
      "nombre": "Cambio de lote",
      "fase": "MVP",
      "sujetos": "animales",
      "crea_animales": false,
      "payload": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "lote_destino_id": {
            "$ref": "#/$defs/uuid"
          }
        },
        "required": [
          "lote_destino_id"
        ]
      }
    },
    "hacienda.identificacion": {
      "nombre": "Identificación / reposición",
      "fase": "MVP",
      "sujetos": "animales (1)",
      "crea_animales": false,
      "payload": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "identificacion": {
            "$ref": "#/$defs/identificacion"
          },
          "accion": {
            "enum": [
              "colocacion",
              "reposicion",
              "retiro"
            ]
          },
          "reemplaza": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tipo",
              "valor"
            ],
            "properties": {
              "tipo": {
                "$ref": "#/$defs/identificacion/properties/tipo"
              },
              "valor": {
                "type": "string",
                "maxLength": 64
              }
            }
          }
        },
        "required": [
          "identificacion",
          "accion"
        ]
      }
    },
    "hacienda.pesaje": {
      "nombre": "Pesaje",
      "fase": "MVP",
      "sujetos": "animales | lote",
      "crea_animales": false,
      "payload": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "modo": {
            "enum": [
              "individual",
              "promedio"
            ]
          },
          "peso_kg": {
            "$ref": "#/$defs/decimal_pos"
          },
          "cantidad": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          },
          "peso_min_kg": {
            "$ref": "#/$defs/decimal_pos"
          },
          "peso_max_kg": {
            "$ref": "#/$defs/decimal_pos"
          },
          "desbaste": {
            "type": "boolean"
          },
          "desbaste_pct": {
            "$ref": "#/$defs/decimal_pos"
          },
          "metodo": {
            "enum": [
              "balanza",
              "cinta",
              "estimado"
            ]
          }
        },
        "required": [
          "modo",
          "peso_kg",
          "metodo"
        ]
      }
    },
    "hacienda.condicion_corporal": {
      "nombre": "Condición corporal",
      "fase": "MVP",
      "sujetos": "animales | lote",
      "crea_animales": false,
      "payload": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "valor": {
            "$ref": "#/$defs/decimal_pos"
          },
          "escala": {
            "enum": [
              "1-5",
              "1-9"
            ]
          }
        },
        "required": [
          "valor",
          "escala"
        ]
      }
    },
    "hacienda.recategorizacion": {
      "nombre": "Recategorización",
      "fase": "MVP",
      "sujetos": "animales | lote(conteo)",
      "crea_animales": false,
      "payload": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "categoria_nueva": {
            "$ref": "#/$defs/codigo"
          },
          "movimientos": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "de",
                "a",
                "cantidad"
              ],
              "properties": {
                "de": {
                  "$ref": "#/$defs/codigo"
                },
                "a": {
                  "$ref": "#/$defs/codigo"
                },
                "cantidad": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "motivo": {
            "enum": [
              "edad",
              "destete",
              "castracion",
              "servicio",
              "parto",
              "denticion",
              "manual"
            ]
          },
          "sugerida": {
            "type": "boolean"
          },
          "regla_id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          }
        },
        "required": [
          "motivo"
        ]
      }
    },
    "hacienda.castracion": {
      "nombre": "Castración",
      "fase": "MVP",
      "sujetos": "animales",
      "crea_animales": false,
      "payload": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "metodo": {
            "enum": [
              "quirurgico",
              "goma",
              "burdizzo",
              "otro"
            ]
          },
          "categoria_nueva": {
            "$ref": "#/$defs/codigo"
          }
        }
      }
    },
    "hacienda.muerte": {
      "nombre": "Muerte",
      "fase": "MVP",
      "sujetos": "animales | lote(conteo)",
      "crea_animales": false,
