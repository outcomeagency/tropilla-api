    },
    "reproduccion.celo": {
      "nombre": "Celo detectado",
      "fase": "F2",
      "sujetos": "animales",
      "crea_animales": false,
      "payload": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "fuente": {
            "enum": [
              "visual",
              "retajo",
              "podometro",
              "otro"
            ]
          }
        },
        "required": [
          "fuente"
        ]
      }
    },
    "reproduccion.servicio_natural": {
      "nombre": "Servicio natural",
      "fase": "MVP",
      "sujetos": "animales | lote",
      "crea_animales": false,
      "payload": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "inicio": {
            "$ref": "#/$defs/fecha"
          },
          "fin": {
            "$ref": "#/$defs/fecha"
          },
          "toro_ids": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "$ref": "#/$defs/uuid"
            }
          },
          "toros_externos": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "$ref": "#/$defs/texto_corto"
            }
          },
          "lote_toros_id": {
            "$ref": "#/$defs/uuid"
          }
        },
        "required": [
          "inicio"
        ]
      }
    },
    "reproduccion.inseminacion": {
      "nombre": "Inseminación (IA / IATF)",
