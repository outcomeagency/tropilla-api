                "$ref": "#/$defs/animal_nuevo/properties/padre_id"
              },
          "madre_externa": {
            "$ref": "#/$defs/animal_nuevo/properties/madre_externa"
          },
          "madre_externa_id": {"$ref":"#/$defs/animal_nuevo/properties/madre_externa_id"},
          "padre_externo_id": {"$ref":"#/$defs/animal_nuevo/properties/padre_externo_id"},
              "padre_externo": {
                "$ref": "#/$defs/animal_nuevo/properties/padre_externo"
              },
              "senas": {
                "$ref": "#/$defs/animal_nuevo/properties/senas"
              },
              "foto": {
                "$ref": "#/$defs/animal_nuevo/properties/foto"
              }
            }
          }
        },
        "required": [
          "cambios"
        ]
      }
    },
    "hacienda.individualizacion": {
      "nombre": "Individualización desde lote anónimo",
      "fase": "MVP",
      "sujetos": "lote(conteo)",
      "crea_animales": true,
      "payload": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "animales": {
            "type": "array",
            "maxItems": 1000,
