            "$ref": "#/$defs/texto"
          },
          "denuncia_numero": {
            "$ref": "#/$defs/texto_corto"
          }
        },
        "required": [
          "tipo"
        ]
      }
    },
    "hacienda.faena": {
      "nombre": "Faena",
      "fase": "MVP",
      "sujetos": "animales | lote(conteo)",
      "crea_animales": false,
      "payload": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "frigorifico": {
            "$ref": "#/$defs/texto_corto"
          },
          "tropa_numero": {
            "$ref": "#/$defs/texto_corto"
          },
          "peso_vivo_kg": {
            "$ref": "#/$defs/decimal_pos"
          },
          "pcc_kg": {
            "$ref": "#/$defs/decimal_pos"
          },
          "pcf_kg": {
            "$ref": "#/$defs/decimal_pos"
          },
          "tipificacion": {
            "$ref": "#/$defs/texto_corto"
          },
          "categoria_faena": {
            "$ref": "#/$defs/codigo"
          },
          "decomisos": {
            "$ref": "#/$defs/texto"
          },
          "operacion_id": {
            "$ref": "#/$defs/uuid"
          }
        },
        "required": [
          "frigorifico"
        ]
      }
    },
    "hacienda.denticion": {
      "nombre": "Dentición",
      "fase": "MVP",
      "sujetos": "animales",
      "crea_animales": false,
      "payload": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "denticion": {
            "enum": [
              "leche",
              "2",
              "4",
              "6_mas"
            ]
          }
        },
        "required": [
          "denticion"
        ]
      }
    },
    "hacienda.actualizacion_ficha": {
      "nombre": "Actualización de datos del animal",
      "fase": "MVP",
      "sujetos": "animales (1)",
      "crea_animales": false,
      "payload": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "cambios": {
